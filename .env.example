# Copy to .env (never commit it). All paths may be absolute.

# --- Telegram (https://my.telegram.org -> API development tools) ---
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef
# The .session file grants FULL access to your account. Keep it on the VM only.
TG_SESSION_PATH=./data/telegram.session

# --- PostgreSQL ---
DATABASE_URL=postgresql://telesync:CHANGE_ME@127.0.0.1:5432/telesync

# --- Google Photos (OAuth client of type "Desktop app") ---
# Leave empty to store photos/videos on local disk instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Obtained once with: python -m scripts.gphotos_auth
GOOGLE_REFRESH_TOKEN=

# --- Storage ---
# Local files (voice, stickers, documents, avatars). nginx serves this dir at /files/
MEDIA_DIR=./data/files
# Photos/videos are downloaded here, uploaded to Google Photos, then deleted.
TEMP_DIR=./data/tmp

# --- Sync worker ---
# Seconds between automatic sync passes (0 = manual only via POST /api/sync/run)
SYNC_INTERVAL_SECONDS=1800
# Skip downloading single files larger than this (MB). 0 = no limit.
MAX_FILE_MB=2000
